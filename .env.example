# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── iCloud / Apple Mail IMAP ──────────────────────────────────────────────
# Your Apple ID email address
MAIL_USER=yourname@icloud.com

# App-specific password (NOT your Apple ID password).
# Generate one at: https://appleid.apple.com → Sign-In & Security → App-Specific Passwords
MAIL_PASS=xxxx-xxxx-xxxx-xxxx

# iCloud IMAP server (change only if using a different provider)
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993

# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Tuning (optional) ─────────────────────────────────────────────────────
# Number of messages to sample per folder
SAMPLE_SENT=150
SAMPLE_INBOX=100

# Path to the CLAUDE.md file to update (defaults to ./CLAUDE.md)
CLAUDE_MD_PATH=./CLAUDE.md
